# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repo.

DATABASE_URL="postgresql://usuario:clave@host:5432/db?sslmode=require"

# Admin
ADMIN_PASSWORD_HASH=""   # node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 12))"
SESSION_SECRET=""        # openssl rand -hex 32

# Wompi (Dashboard > Desarrolladores). Empieza con las llaves de sandbox (pub_test_...)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# URL pública del sitio, sin "/" al final (redirect de Wompi y enlaces en correos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Correos (opcional)
RESEND_API_KEY=""
ORDER_NOTIFICATIONS_FROM_EMAIL=""

# Imágenes (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
