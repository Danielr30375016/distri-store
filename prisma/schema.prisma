// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  images      String[] @default([])
  desc        String
  category    String
  subcategory String?
  reference   String?
  brand       String?
  discount    Int      @default(0)
  stock       Boolean  @default(true)
  quantity    Int      @default(0)
}

model Banner {
  id      Int     @id @default(autoincrement())
  image   String
  title   String  @default("")
  isPromo Boolean @default(false)
  price   Int?
  order   Int     @default(0)
  active  Boolean @default(true)
}

model Brand {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  image String?
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  image         String?
  subcategories Subcategory[]
}

model Subcategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

model LoginAttempt {
  id          Int      @id @default(autoincrement())
  ip          String   @unique
  attempts    Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id            Int         @id @default(autoincrement())
  // Referencia aleatoria (no adivinable). Se envía a Wompi y se usa en la URL pública
  // /pedido/<reference>, para que nadie pueda ver pedidos ajenos cambiando el número.
  reference     String      @unique
  customerName  String
  phone         String
  email         String
  address       String
  total         Int
  status        OrderStatus @default(PENDING)
  wompiReference String?    @unique // id de la transacción en Wompi
  paymentMethod String?
  stockReleased Boolean     @default(false) // true cuando el stock reservado ya se devolvió
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name      String
  price     Int
  quantity  Int
}
